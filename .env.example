# MQTT — Authentik OAuth (client credentials)
MQTT_HOST=mosquitto-broker
MQTT_PORT=1883
AUTHENTIK_URL=https://sso.caronboulme.fr
AUTHENTIK_CLIENT_ID=agent-search-client
AUTHENTIK_CLIENT_SECRET=your_client_secret_here

# LLM local (llama.cpp)
LLM_BASE_URL=http://thebrain:8000/v1
LLM_MODEL=gemma-4-12b-it
LLAMACPP_API_KEY=your_llamacpp_key_here

# Optionnel
DEFAULT_N_RESULTS=8
FETCH_TOP_N=8
CONTEXT_TTL_SECONDS=7200

# Fallback si SearXNG renvoie peu/pas de contenu exploitable (laisser vide pour désactiver)
TAVILY_API_KEY=

# Toujours interrogé en parallèle de SearXNG, quota généreux (laisser vide pour désactiver)
ANYSEARCH_API_KEY=
