VK_URL=http://voight-kampff:8080
MQTT_HOST=mosquitto-broker
MQTT_PORT=1883
MQTT_SERVICE_USERNAME=search
MQTT_SERVICE_API_KEY=your_api_key_here

# LLM local (llama.cpp)
LLM_BASE_URL=https://thebrain.caronboulme.fr
LLM_MODEL=gemma-4-12b-it
LLAMACPP_API_KEY=your_llamacpp_key_here

# Optionnel
DEFAULT_N_RESULTS=8
FETCH_TOP_N=8
CONTEXT_TTL_SECONDS=7200

# Fallback si SearXNG renvoie peu/pas de contenu exploitable (laisser vide pour désactiver)
TAVILY_API_KEY=

# Toujours interrogé en parallèle de SearXNG, quota généreux (laisser vide pour désactiver)
ANYSEARCH_API_KEY=
